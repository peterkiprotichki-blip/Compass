  "description": "Compass — Guidance Platform for African Entrepreneurs (Angular, NestJS, MongoDB)",
  "private": true,
  "scripts": {
    "start:db": "\"C:\\Program Files\\MongoDB\\Server\\8.2\\bin\\mongod.exe\" --dbpath ./backend/data/db --port 27017 --bind_ip 127.0.0.1",
    "start:backend": "npm --prefix backend run start",
